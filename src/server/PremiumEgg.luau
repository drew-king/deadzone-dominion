-- Studio prototype. Receipts here are generated by test code, not MarketplaceService.
local Egg = {
	ProposedRobux = 99,
	Outcomes = {
		{Id = "Arc", Weight = 650},
		{Id = "Crown", Weight = 300},
		{Id = "Nova", Weight = 50},
	},
}

function Egg.simulate(profile, receiptId, roll)
	if not game:GetService("RunService"):IsStudio() then return false, "Studio only" end
	if profile.testEggReceipts and profile.testEggReceipts[receiptId] then
		return true, profile.testEggReceipts[receiptId]
	end
	assert(type(receiptId) == "string" and #receiptId > 0, "Expected a test receipt ID")
	assert(type(roll) == "number" and roll % 1 == 0 and roll >= 1 and roll <= 1000, "Expected a roll in 1–1000")
	profile.testEggReceipts = profile.testEggReceipts or {}
	for _, outcome in Egg.Outcomes do
		roll -= outcome.Weight
		if roll <= 0 then
			profile.pets[outcome.Id] = true
			profile.testEggReceipts[receiptId] = outcome.Id
			return true, outcome.Id
		end
	end
end

return Egg
